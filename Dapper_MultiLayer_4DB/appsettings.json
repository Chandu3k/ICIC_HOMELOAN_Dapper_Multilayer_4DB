{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "restrictedToMinimumLevel": "Information",
          "formatter": "Serilog.Formatting.Json.JsonFormatter"
          // "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {CorrelationId} {Level:u3} {Username} {Message:lj}{Exception}{NewLine}"
        }
      },
      {
        "Name": "Debug",
        "Args": {
          "restrictedToMinimumLevel": "Debug"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "ConnectionStrings": {
    "Hotels_DBsqlConnectionString": "Server=DESKTOP-GFR20G2;Database=HotelManagement_UAT;Integrated Security=True;TrustServerCertificate=True;MultipleActiveResultSets=True;",
    "Restaurants_DBsqlConnectionString": "Server=DESKTOP-GFR20G2;Database=Restaurant_UAT;Integrated Security=True;TrustServerCertificate=True;MultipleActiveResultSets=True;",
    "Products_DBsqlConnectionString": "Server=DESKTOP-GFR20G2;Database=Northwind_UAT;Integrated Security=True;TrustServerCertificate=True;MultipleActiveResultSets=True;",
    "Midland_DBsqlConnectionString": "Server=DESKTOP-GFR20G2;Database=Midland_UAT;Integrated Security=True;TrustServerCertificate=True;MultipleActiveResultSets=True;",
    "Logs_DBsqlConnectionString": "Server=DESKTOP-GFR20G2;Database=GitamUniversity;Integrated Security=True;TrustServerCertificate=True;MultipleActiveResultSets=True;"
  },
  "Jwt": { //To prepare the token the below key values information is required.
    "Key": "Yh2k7QSu4l8CZg5p6X3Pna9L0Miy4D3Bvt0JVr87UcOj69Kqw5R2Nmf4FWs03Hdx",
